{
  "name": "recall-study",
  "version": "0.6.2-preview.1",
  "private": true,
  "type": "module",
  "description": "A focused, local adaptive exam learning tool.",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "recall": "bin/recall.mjs"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "server": "tsx src/server/main.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/pwa.ts",
    "start": "tsx src/server/main.ts",
    "local": "tsx scripts/local.ts",
    "recall": "tsx src/cli.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx src/cli.ts import examples/demo.json",
    "test": "tsx --test tests/engine.test.ts tests/import.test.ts tests/cache.test.ts tests/prerequisites.test.ts tests/library.test.tsx tests/proxy.test.ts tests/portable.test.ts tests/personal.test.ts tests/recovery.test.ts tests/learning.test.ts tests/reset.test.ts tests/controls.test.ts tests/hints.test.ts tests/appearance.test.tsx tests/updates.test.ts tests/i18n.test.tsx tests/authoring.test.ts tests/backup.test.ts tests/dictation.test.tsx",
    "test:integration": "tsx --test tests/integration.test.ts",
    "check": "npm run check:i18n && npm run check:public && npm test && npm run test:integration && npm run build",
    "schema": "tsx scripts/schema.ts",
    "format": "prettier --write src scripts tests vite.config.ts",
    "check:public": "tsx scripts/check-public.ts",
    "build:standalone": "tsc --noEmit && tsx scripts/standalone.ts",
    "test:installer": "tsx --test tests/windows-installer.test.ts",
    "check:i18n": "tsx scripts/check-i18n.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "commander": "^14.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.0",
    "i18next": "^26.7.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
